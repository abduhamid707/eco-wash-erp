{
  "name": "eco-wash-erp",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter @eco/api --filter @eco/web dev",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter @eco/api db:generate",
    "db:migrate": "pnpm --filter @eco/api db:migrate",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@playwright/test": "^1.56.1"
  }
}
